# ---- Database (Railway Postgres) ----
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME"

# ---- Auth0 (@auth0/nextjs-auth0 v3) ----
AUTH0_SECRET="generate-with: openssl rand -hex 32"
AUTH0_BASE_URL="https://<your-railway-domain>"
AUTH0_ISSUER_BASE_URL="https://<tenant>.us.auth0.com"
AUTH0_CLIENT_ID=""
AUTH0_CLIENT_SECRET=""

# Set to "true" to bypass the Auth0 gate in local development only.
# NEVER set this in production.
AUTH_DISABLED="false"

# ---- Interim Zapier inbound feed (Phase 1) ----
# Shared secret Zapier sends in the X-Webhook-Secret header.
ZAPIER_INBOUND_SECRET=""

# ---- Phase 2: Meta Lead Ads ----
META_APP_SECRET=""        # webhook signature verification (X-Hub-Signature-256)
META_VERIFY_TOKEN=""      # GET handshake token you choose
META_GRAPH_TOKEN=""       # page/system token used to fetch leads from the Graph API
META_GRAPH_VERSION="v19.0"

# ---- Phase 3: MailerLite ----
MAILERLITE_API_KEY=""        # MailerLite "new" API token (connect.mailerlite.com)
MAILERLITE_GROUP_ID=""       # group new leads are added to (the "Leads" group)
MAILERLITE_BASE_URL=""       # optional override; defaults to the public API
MAILERLITE_WEBHOOK_SECRET="" # optional shared secret for the inbound webhook
# NOTE: create a custom field with key `crm_status` in MailerLite so status syncs.

# ---- Phase 4: Stripe ----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---- Phase 5: Outlook / Microsoft Graph (app-only) ----
MS_TENANT_ID=""           # Azure AD tenant id
MS_CLIENT_ID=""           # Azure app (client) id
MS_CLIENT_SECRET=""       # Azure app client secret
MS_GRAPH_SENDER=""        # mailbox UPN/id to send mail + create events as
# App permissions required: Mail.Send, Calendars.ReadWrite (admin-consented).
